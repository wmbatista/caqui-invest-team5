#!/bin/sh
# Trava de commit (CQ-10 e "nenhum segredo no repositório"): barra CPF completo e chave ou senha no que vai ser commitado.
# Instalar: git config core.hooksPath ferramentas/hooks
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -qE '[0-9]{3}\.[0-9]{3}\.[0-9]{3}-[0-9]{2}|sk-or-[A-Za-z0-9-]{10,}|(API_KEY|_SENHA)=[A-Za-z0-9_-]{12,}'; then
  echo "pre-commit: CPF completo ou segredo no commit. Tire antes de commitar." >&2
  exit 1
fi
