{
  "name": "@caqui/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/src/server.js",
    "llm:ping": "tsx --env-file-if-exists=../../.env src/llm-ping.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "avaliar": "tsx scripts/avaliar.ts"
  },
  "dependencies": {
    "@fastify/cors": "8.5.0",
    "fastify": "4.28.1",
    "zod": "^3.23.8",
    "@caqui/contracts": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "^2.6.0"
  }
}
