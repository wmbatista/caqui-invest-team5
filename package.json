{
  "name": "caqui-invest-team5",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@caqui/backend",
    "dev:frontend": "npm run dev --workspace=@caqui/frontend",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@caqui/backend",
    "llm:ping": "npm run llm:ping --workspace=@caqui/backend",
    "typecheck": "npm run typecheck --workspace=@caqui/backend",
    "test": "npm run test --workspace=@caqui/backend",
    "check": "npm run check --workspace=@caqui/backend && npm run build --workspace=@caqui/frontend"
  },
  "overrides": {
    "toad-cache": "3.3.0"
  }
}
